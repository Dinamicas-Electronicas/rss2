FROM python:3.11-slim-bookworm

WORKDIR /app

ENV PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    TOKENIZERS_PARALLELISM=false \
    HF_HOME=/cache

RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq-dev gcc \
    && rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir --upgrade pip
# torch desde el indice de CPU: el wheel de PyPI arrastra las librerias CUDA
# (~2-3 GB) que este worker no usa (DEVICE=cpu). Misma decision que en
# Dockerfile.tts.
RUN pip install --no-cache-dir torch==2.15.0 --index-url https://download.pytorch.org/whl/cpu
RUN pip install --no-cache-dir psycopg2-binary==2.9.10 "numpy==1.26.4" sentence-transformers==6.3.0 flask==3.1.3

COPY workers/embeddings_worker.py ./workers/embeddings_worker.py
COPY workers/__init__.py ./workers/__init__.py

ENV DB_HOST=db \
    DB_PORT=5432 \
    DB_NAME=rss \
    DB_USER=rss \
    DB_PASS=${DB_PASS}

CMD ["python", "workers/embeddings_worker.py"]
