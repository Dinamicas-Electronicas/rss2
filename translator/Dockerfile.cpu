FROM python:3.11-slim-bookworm

RUN apt-get update && apt-get install -y --no-install-recommends \
    patchelf libpq-dev gcc git curl wget \
    && rm -rf /var/lib/apt/lists/*

ENV PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    TOKENIZERS_PARALLELISM=false \
    HF_HOME=/root/.cache/huggingface

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir --upgrade pip

# torch solo se usa para convertir el modelo a CTranslate2 (translator-models);
# la traduccion en si la hace CTranslate2. Se instala desde el indice de CPU
# para no arrastrar las librerias CUDA (~2-3 GB) que no se usan.
RUN pip install --no-cache-dir torch==2.15.0 --index-url https://download.pytorch.org/whl/cpu

RUN pip install --no-cache-dir \
    ctranslate2==4.9.0 \
    sentencepiece==0.2.3 \
    transformers==5.23.0 \
    protobuf==6.33.5 \
    "numpy==1.26.4" \
    psycopg2-binary==2.9.10 \
    langdetect==1.0.9 \
    redis>=5.0.0

RUN find /usr/local/lib/python3.11/site-packages/ctranslate2* \
    -name "libctranslate2-*.so.*" -o -name "libctranslate2.so*" | \
    xargs -I {} patchelf --clear-execstack {} || true

COPY workers/ ./workers/

ENV DB_HOST=db
ENV DB_PORT=5432
ENV DB_NAME=rss
ENV DB_USER=rss
ENV DB_PASS=${DB_PASS}

CMD ["python", "-m", "workers.ctranslator_worker"]